# ## Start with an empty to-do list:
# 
#     todo = []
# 
#     Add "Wake up early" using append()
#     
#     Add "Exercise" using append()
#     
#     Insert "Drink water" at the beginning of the list
#     
#     Add these two tasks at the end using extend(): ["Study Python", "Read a book"]
#     
#     Print the final todo list after each step (or at the end).

# In[6]:


todo = []
todo.append("Wake up early")
todo.append("Exercise")
todo.insert(0, "Drink water")
todo.extend(["Study Python", "Read a book"])
print(todo)


# ## You have this inventory list:
