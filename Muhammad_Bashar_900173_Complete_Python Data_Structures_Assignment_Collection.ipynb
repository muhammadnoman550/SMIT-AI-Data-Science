#     inventory = ["Laptop", "Mouse", "Keyboard"]
# 
#     Add "Monitor" at the end
#     Insert "Headphones" at index 1
#     Add these items using extend(): ["USB Cable", "Webcam"]
# 
# Print the updated inventory.

# In[6]:


