# ## Create a dictionary that manages records of two patients.
# 
# Each patient should have:
# 
#     Patient ID
#     Name
#     Age
#     Disease
#     Doctor Assigned
#     Medicines (a nested dictionary of medicine names and their doses)
# 
# ### Example:
# 
#     Patient 1: ID 501, Name Bilal, Age 45, Disease Diabetes, Doctor Dr. Ayesha
#     Medicines: Metformin 500mg, Insulin 10 units
#     Patient 2: ID 502, Name Hina, Age 32, Disease Flu, Doctor Dr. Usman
#     Medicines: Paracetamol 500mg, Cough Syrup 10ml
# 
# ### Tasks:
# 
# Print the complete patient records.
# 
# Print only the medicines of Patient 1.
# 
# Add a new medicine "Vitamin D" with dose "1000 IU" for Patient 2.
# 
# Change the doctor of Patient 1 to "Dr. Kamran".
# 
# Update Patient 2’s age to 33.
# 
# Print the final records.

# In[24]:


patients = {
    "Patient 1": {
        "Patient ID": 501,
        "Name": "Bilal",
        "Age": 45,
        "Disease": "Diabetes",
        "Doctor Assigned": "Dr. Ayesha",
        "Medicines": {
            "Metformin": "500mg",
            "Insulin": "10 units"
        }
    },
    "Patient 2": {
        "Patient ID": 502,
        "Name": "Hina",
        "Age": 32,
        "Disease": "Flu",
        "Doctor Assigned": "Dr. Usman",
        "Medicines": {
            "Paracetamol": "500mg",
            "Cough Syrup": "10ml"
        }
    }
}

print("Complete patient records:")
print(patients)
print("Patient 1 medicines:", patients["Patient 1"]["Medicines"])

patients["Patient 2"]["Medicines"]["Vitamin D"] = "1000 IU"
patients["Patient 1"]["Doctor Assigned"] = "Dr. Kamran"
patients["Patient 2"]["Age"] = 33

print("Final records:")
print(patients)


# ## Create a nested dictionary for a company that stores three employees.
# 
# Each employee should have:
# 
#     Employee ID
#     Name
#     Department
#     Salary
#     Skills (a list of skills inside the dictionary)
# 
# Employees:
# 
#     ID 201: Name Ali, Department IT, Salary 75000, Skills: Python, SQL, HTML
#     ID 202: Name Fatima, Department HR, Salary 60000, Skills: Communication, Recruitment
#     ID 203: Name Zain, Department Finance, Salary 80000, Skills: Excel, Accounting
# 
# ### Tasks:
# 
#     Print the complete employee database.
#     Print only the skills of employee 201.
#     Add a new skill "JavaScript" for Ali.
#     Increase Fatima’s salary to 65000.
#     Add a new employee: ID 204, Name Hina, Department Marketing, Salary 55000, Skills: SEO, Content Writing.
#     Remove employee 203.
#     Print the final database.

# In[25]:


employees = {
    201: {
        "Employee ID": 201,
        "Name": "Ali",
        "Department": "IT",
        "Salary": 75000,
        "Skills": ["Python", "SQL", "HTML"]
    },
    202: {
        "Employee ID": 202,
        "Name": "Fatima",
        "Department": "HR",
        "Salary": 60000,
        "Skills": ["Communication", "Recruitment"]
    },
    203: {
        "Employee ID": 203,
        "Name": "Zain",
        "Department": "Finance",
        "Salary": 80000,
        "Skills": ["Excel", "Accounting"]
    }
}

print("Complete employee database:")
print(employees)
print("Employee 201 skills:", employees[201]["Skills"])

employees[201]["Skills"].append("JavaScript")
employees[202]["Salary"] = 65000
employees[204] = {
    "Employee ID": 204,
    "Name": "Hina",
    "Department": "Marketing",
    "Salary": 55000,
    "Skills": ["SEO", "Content Writing"]
}
del employees[203]

print("Final database:")
print(employees)


# ## Create a dictionary that stores information of two flights.
# 
# Each flight should contain:
# 
#     Flight Number
#     Airline
#     Departure City
#     Arrival City
#     Passengers (nested dictionary of passenger name and seat number)
#     Ticket Price
# 
# ### Example:
# 
#     Flight PK-301: Airline PIA, Lahore → Karachi
#     Passengers: Ali (Seat 12A), Sara (Seat 14B)
#     Price: 18000
#     Flight EK-502: Airline Emirates, Islamabad → Dubai
#     Passengers: Ahmed (Seat 5C), Hina (Seat 8D)
#     Price: 45000
# 
# ### Tasks:
# 
#     Print the complete flight data.
#     Print only the passengers of Flight PK-301.
#     Add a new passenger "Bilal" with seat "15C" in Flight PK-301.
#     Change the ticket price of Flight EK-502 to 47000.
#     Update Sara’s seat to "14C".
#     Print the final flight information.

# In[29]:


flights = {
    "PK-301": {
        "Flight Number": "PK-301",
        "Airline": "PIA",
        "Departure City": "Lahore",
        "Arrival City": "Karachi",
        "Passengers": {
            "Ali": "12A",
            "Sara": "14B"
        },
        "Ticket Price": 18000
    },
    "EK-502": {
        "Flight Number": "EK-502",
        "Airline": "Emirates",
        "Departure City": "Islamabad",
        "Arrival City": "Dubai",
        "Passengers": {
            "Ahmed": "5C",
            "Hina": "8D"
        },
        "Ticket Price": 45000
    }
}

print("Complete flight data:")
print(flights)
print("PK-301 passengers:", flights["PK-301"]["Passengers"])

flights["PK-301"]["Passengers"]["Bilal"] = "15C"
flights["EK-502"]["Ticket Price"] = 47000
flights["PK-301"]["Passengers"]["Sara"] = "14C"

print("Final flight information:")
print(flights)


