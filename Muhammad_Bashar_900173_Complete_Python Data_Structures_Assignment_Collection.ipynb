# ## scores
#     scores = [88, 92, 75, 88, 95, 88, 70]
# ### Print:
#     
#     How many times 88 appears (count)
#     The index of the first occurrence of 95
#     The length of the list
#     The highest and lowest score using built-in functions (max and min)

# In[8]:


scores = [88, 92, 75, 88, 95, 88, 70]
print("88 appears:", scores.count(88), "times")
print("Index of 95:", scores.index(95))
print("Length:", len(scores))
print("Highest:", max(scores))
print("Lowest:", min(scores))


